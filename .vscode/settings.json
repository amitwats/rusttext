  // Syntax colors chosen to stay readable on the bright blue background
  // (default dark-theme blues/greens would blend into it).
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#cfe6fb", "fontStyle": "italic" } },
      { "scope": ["keyword", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#ffe082", "fontStyle": "bold" } },
      { "scope": ["string", "string.quoted"], "settings": { "foreground": "#d4ffd0" } },
      { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#ffcc80" } },
      { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#ffffff", "fontStyle": "bold" } },
      { "scope": ["entity.name.type", "entity.name.class", "support.type", "entity.name.struct", "entity.name.enum", "entity.name.trait"], "settings": { "foreground": "#b2fff6" } },
      { "scope": ["variable", "variable.other", "variable.parameter"], "settings": { "foreground": "#ffffff" } },
      { "scope": ["entity.name.tag", "entity.name.namespace", "entity.name.module"], "settings": { "foreground": "#ffd1f0" } },
      { "scope": ["entity.other.attribute-name", "meta.attribute"], "settings": { "foreground": "#fff3c4" } },
      { "scope": ["entity.name.function.macro", "support.macro"], "settings": { "foreground": "#ffb4d9" } },
      { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#e6f3ff" } },
      { "scope": ["invalid"], "settings": { "foreground": "#ffb4b4" } }
    ]
  },
  "editor.semanticTokenColorCustomizations": {
    "enabled": true,
    "rules": {
      "function": "#ffffff",
      "method": "#ffffff",
      "macro": "#ffb4d9",
      "type": "#b2fff6",
      "struct": "#b2fff6",
      "enum": "#b2fff6",
      "interface": "#b2fff6",
      "keyword": "#ffe082",
      "namespace": "#ffd1f0",
      "variable": "#ffffff",
      "parameter": "#f0f8ff",
      "property": "#e6f3ff",
      "lifetime": "#ffcc80",
      "comment": "#cfe6fb",
      "string": "#d4ffd0",
      "number": "#ffcc80"
    }
  }
}
